@white: hsl(0,0%,100%);
@black: hsl(0,0%,0%);
@accent: hsl(247, 5%,71%);
@lightAccent: hsl(49,100%,57%);
@darkAccent: hsl(270,8%,35%);

@body-text-color: @black;
@body-text-link-color: hsl(0, 0%, 80%);
@caption-yellow: hsl(56, 100%, 84%);
@caption-black: @black;
@caption-active: hsl(354, 90%, 80%) !important;
@comic-blue: hsl(218, 56%, 32%);
@comic-orange: hsl(37, 100%, 50%);
@comic-yellow: hsl(49,100%,56.99999999999999%);
@comic-purple: hsl(297, 51%, 38%);
@form-field-backgrounds: hsla(240, 14%, 97%, 1);

// Brand Colors
@blueskyColor: #01A6FF;
@emailColor: #7f7f7f;
@githubColor: #4183c4;
@instagramColor: #c13584;
@linkedinColor: #007fb1;
@mastodonColor: #6364FF;
@patreonColor: #FF424D;
@pinterestColor: #cb2128;
@substackColor: #ff6719;
@tumblrColor: #2c4762;
@youtubeColor: #ff3333;

h1, h2 {
