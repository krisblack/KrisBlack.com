h2 + p, h3 + p, h4 + p, h5 + p, h6 + p,
h2 + ul, h3 + ul, h4 + ul, h5 + ul, h6 + ul,
h2 + ol, h3 + ol, h4 + ol, h5 + ol, h6 + ol {
	margin-top: -1em; 
}

p a,
.blog-more-link,
.summary-read-more-link,
.summary-title a.summary-title-link,
ul a,
ol a {
	font-weight: 700 !important;
}

// COLOPHON

.stage-sqsp {
	width: 100%;
	height: auto;
}

.palette-sqsp {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 100%;
	flex-shrink: 0;
}

.palette-sqsp .color {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: inherit;
	justify-content: flex-start;
	width: 100%;
	flex-shrink: 0;
}

.palette-sqsp .color::before {
	display: block;
	content: " ";
	width: 20px;
	height: 20px;
	margin: 6px;
	border-radius: 7.5px;
	box-shadow: 0 1px 2px rgba(0,0,0,0.15);
	border: 1px solid @black;
}

.palette-sqsp:nth-child(1) .color:nth-child(1)::before { background: @white; }
.palette-sqsp:nth-child(1) .color:nth-child(2)::before { background: @lightAccent; }
.palette-sqsp:nth-child(1) .color:nth-child(3)::before { background: @accent; }
.palette-sqsp:nth-child(1) .color:nth-child(4)::before { background: @darkAccent; }
.palette-sqsp:nth-child(1) .color:nth-child(5)::before { background: @black; }